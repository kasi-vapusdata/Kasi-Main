{
  "default": {
    "paths": ["src/test/features/**/*.feature"],
    "require": [
      "src/test/steps/**/*.ts",
      "src/hooks/hooks.ts"
    ],
    
    "requireModule": ["ts-node/register"],
    "format": [
        "progress",
        "html:test-results/cucumber-report.html",
        "json:test-results/cucumber-report.json",
        "rerun:@rerun.txt"
    ],
    "parallel":1,
    "publishQuiet": true
  },

  "rerun": {
    "require": [
      "src/test/steps/**/*.ts",
      "src/hooks/hooks.ts"
    ],
    
    "requireModule": ["ts-node/register"],
    "format": [
        "progress",
        "html:test-results/cucumber-report.html",
        "json:test-results/cucumber-report.json",
        "rerun:@rerun.txt"
    ],
    "publishQuiet": true
  }

  
  
}
